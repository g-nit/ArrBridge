{
  "manifest_version": 3,
  "name": "ArrBridge \u2192 IMDB / Radarr / Sonarr",
  "version": "1.0.0",
  "description": "Browse IMDb, detect Movies and TV, check Radarr/Sonarr, discover recommendations, and add titles.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*/*",
    "https://imdb.com/*",
    "https://tmdb.org/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
      ],
  "action": {
    "default_title": "ArrBridge \u2192 IMDB / Radarr / Sonarr",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.imdb.com/title/*",
        "https://imdb.com/title/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}